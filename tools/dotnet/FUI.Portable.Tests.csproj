<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <ProjectReference Include="FUI.Core.csproj" />
    <ProjectReference Include="FUI.Testing.csproj" />
    <ProjectReference Include="FUI.Navigation.csproj" />
    <ProjectReference Include="$(FuiPackageRoot)FUI.Generators~/FUI.Generators.csproj" Aliases="Generators" />
    <Compile Include="$(FuiPackageRoot)Tests/Shared/NavigatorTestDoubles.cs" />
    <Compile Include="$(FuiPackageRoot)Tests/Editor/BindingPrimitivesTests.cs" />
    <Compile Include="$(FuiPackageRoot)Tests/Editor/NavigatorTests.cs" />
    <Compile Include="$(FuiPackageRoot)Tests/Editor/NavigatorOpenQueueTests.cs" />
    <Compile Include="Tests/**/*.cs" />
    <None Include="Tests/*.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
